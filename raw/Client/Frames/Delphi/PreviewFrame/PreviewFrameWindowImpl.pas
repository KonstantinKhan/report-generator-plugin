procedure TPreviewFrameWindow.ShowThumbnail(const FileName: String);
var XtractImage: IExtractImage;
    Bmp: TBitmap;
    Icon: TIcon;
    ColorDepth: Integer;
    Flags: DWORD;
    RT: IRunnableTask;
    jpgImg: TJPEGImage;
    res : Integer;
const
  dwLocationFlags = IEIFLAG_ASPECT or IEIFLAG_OFFLINE or IEIFLAG_SCREEN
                 or IEIFLAG_QUALITY or IEIFLAG_ORIGSIZE;
begin
  res := -1;
  if not FileExists(FileName) then
    Exit;  // выход с ошибкой
  ColorDepth := 32;
  Flags := dwLocationFlags;
  Bmp := nil;
  Icon := nil;
  try
    try
      if GetExtractImageItfPtr(FileName, XTractImage) and ExtractImageGetFileThumbnail(XtractImage, 256, 256, ColorDepth, Flags, RT, Bmp) then
        res := 0
      else
      if GetFileLargeIcon(FileName, Icon) and (Icon <> nil) and (bmp <> nil) then
        begin
          bmp.Height := Icon.Height;
          bmp.Width := Icon.Width;
          bmp.Canvas.Draw(0, 0, icon);
          res := 0;

        end;

      if Assigned(bmp) then
        img1.Picture.Bitmap := Bmp;

    except
      res := -1;
    end;
  finally
    if Assigned(Icon) then
      Icon.Free;
    if Assigned(Bmp) then
      Bmp.Free;
  end;
end;




