//Один из самых важных методов жизненного цикла фрейма. ЛОЦМАН Клиент
//вызывает его, когда необходимо обновить иформацию отображаемую фреймом.
//Это происходит при загрузке фрейма, при смене выделенного в родительском
//фрейме объекта (в данном случае во фрейме "Файлы), при нажатии
//кнопки "Обновить" и т.д.
procedure TPreviewFrameWindow.OnStartRefresh; safecall;
var ParentFrameContainer : IFrameContainer;
    ParentFrameContainerContent : IContent;
    pdmdata : IPDMData;
    PDMFile : iPDMFile;
    stFilename : string;
begin
  img1.Picture.Bitmap := nil;
  ParentFrameContainer := Self.FContainer.ParentFrame; //Получаем родительский фрейм
  if ParentFrameContainer<>nil then
  begin
    ParentFrameContainerContent := ParentFrameContainer.Content;  //Содержимое родительского фрейма
    if ParentFrameContainerContent.SelectedCount > 0 then
    begin
      //Проверим действительно ли выделенный объект файл
      if idispatch(ParentFrameContainerContent.SelectedByIndex(0)).QueryInterface(IID_IPDMFile, PDMFile)= s_ok  then
      begin
        try
           //Для демонстрации вызова методов сервера приложений выгрузим файл так
           stFilename := (FContext.Connection as ISimpleAPI2).RunMethod('ExtractFile', VarArrayOf(['','','', PDMFile.Document.ID, PDMFile.Name, PDMFile.LocalName, 1]));
           //stFileName := PDMFile.Load; 
           ShowThumbnail(stFilename); //Рисуем миниатюру
        except
        end;
      end;
    end;
  end;
end;

